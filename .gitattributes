# Auto detect text files and perform LF normalization
* text=auto

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# 保留权威点表字节，避免跨平台换行转换破坏同步校验。
data/current/*.csv -text
